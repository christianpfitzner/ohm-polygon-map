# RViz 2 view of the lab "Polygon map" — a template: `{robot}` becomes the robot of the run
# (ohm_polygon_map/launching.py writes /tmp/ohm_polygon_map_<robot>.rviz). Edit this file.
#
# Fixed frame `map` is the hall: the scan and the map the node draws in the laser frame land on the
# hall's walls, so a wrong line is visible at a glance. Reliable QoS everywhere, as the simulator publishes.
Panels:
  - Class: rviz_common/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
      Splitter Ratio: 0.5
    Tree Height: 460
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.4
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 120; 128; 145
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Grid (1 m)
      Normal Cell Count: 0
      Offset:
        X: 5
        Y: 3.5
        Z: 0
      Plane: XY
      Plane Cell Count: 12
      Reference Frame: map
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: false
      Marker Scale: 0.6
      Name: TF
      Show Arrows: false
      Show Axes: true
      Show Names: false
      Update Interval: 0
      Value: true
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Class: rviz_default_plugins/LaserScan
      Color: 230; 230; 230
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: false
      Name: raw scan
      Position Transformer: XYZ
      Selectable: true
      Size (Pixels): 3
      Size (m): 0.04
      Style: Flat Squares
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /{robot}/scan
      Use Fixed Frame: true
      Use rainbow: false
      Value: false
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: polygon map
      Namespaces: {}
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /{robot}/polygon_map/markers
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/Polygon
      Color: 200; 16; 46
      Enabled: false
      Name: room (PolygonStamped)
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /{robot}/polygon_map/room
      Value: false
  Enabled: true
  Global Options:
    Background Color: 33; 36; 43
    Default Light: true
    Fixed Frame: map
    Frame Rate: 10
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Angle: 0
      Class: rviz_default_plugins/TopDownOrtho
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Scale: 70
      Target Frame: <Fixed Frame>
      Value: TopDownOrtho (rviz_default_plugins)
      X: 5
      Y: 3.5
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 720
  Hide Left Dock: false
  Width: 1100
